# Honeybank — single env file for the whole stack. Copy to .env and fill in.
# Everything is LIVE: each feature needs its real key or it errors. No fake/offline mode.
# Do NOT put inline "# comments" after a value — env_file keeps them as part of the value.
#
#   cp .env.example .env
#   ./start.sh                    # local (no Docker)
#   docker compose up --build     # containers

# ─── Capital One Nessie v2 (the bank data layer) ───────────────────────────
# Get a key at https://v2.nessieisreal.com/. Shared by the proxy and orchestrator. Required.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_WEBHOOK_SECRET=

# ─── Public URL / tunnel ───────────────────────────────────────────────────
# Honeybank's public address: the sign-in page the scam email links to, the Nessie webhook callback,
# and what the Daytona agent opens. dev.py manages the tunnel for you (TUNNEL=ngrok by default when
# ngrok is installed): it reuses an ngrok already forwarding :3000 or starts one, and passes the live
# URL to the orchestrator — so PUBLIC_URL never goes stale.
#   one-time setup:  brew install ngrok && ngrok config add-authtoken <token from dashboard.ngrok.com>
#   stable address:  claim your free static domain at dashboard.ngrok.com/domains and set NGROK_DOMAIN
#                    (or just put it in PUBLIC_URL) — then the link in your demo email never changes.
# TUNNEL=cloudflared runs a named Cloudflare tunnel from CLOUDFLARE_TUNNEL_TOKEN (PUBLIC_URL = its
# hostname); TUNNEL=none uses PUBLIC_URL as-is. With no public URL, webhooks fall back to polling.
TUNNEL=ngrok
NGROK_DOMAIN=
PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Proxy <-> orchestrator <-> agent ──────────────────────────────────────
INTERNAL_SECRET=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300
# Tripwires + intel. The bank's per-transfer ceiling (cents; the proxy declines above it, and a
# scammer who splits the drain underneath it is structuring, which the playbook records).
TRANSFER_LIMIT_CENTS=500000
# Bank-wide screening of every pending transfer against the honeypot's mule watchlist: a Nessie
# decision hook when PUBLIC_URL is set (declined before it settles), else the poller cancels hits.
WATCHLIST_BLOCK=1

# ─── Anthropic (classification, replies, identities, the agent's brain) ────
# Required. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Daytona (one disposable sandbox per engagement for the decoy agent) ───
# Required to run the agent. https://www.daytona.io/docs/ — create an API key in the dashboard.
# API_URL and TARGET are optional (Cloud defaults; TARGET is 'us' or 'eu').
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
# Where the decoy agent's browser runs: auto | daytona | local.
#   auto (default): a Daytona sandbox when it can reach PUBLIC_URL, else this machine. Daytona Tier 1/2
#   sandboxes can only reach an egress allowlist (PyPI, AI APIs, …), which excludes ngrok/cloudflared
#   tunnels — so on those tiers auto runs the agent locally (headless Chromium via Playwright).
#   Tier 3+ has open egress and auto uses the sandbox.
AGENT_RUNTIME=auto
# Decoy brain: dom (default, DOM-scraping Playwright agent) or computer_use (experimental screen-driving agent).
AGENT_DRIVER=dom

# ─── Gmail (inbound scam mail + OTP/reply delivery) ────────────────────────
# EASY — App Password (recommended): enable 2-Step Verification, then
#   myaccount.google.com/apppasswords  -> paste the 16-char password (spaces ok). SMTP/IMAP, no deps.
# ADVANCED — OAuth: leave GMAIL_APP_PASSWORD blank, create a Desktop OAuth client, enable the Gmail
#   API, then `python backend/scripts/gmail_authorize.py`.
# Needed for real inbound mail and to deliver OTP/replies. The OTP flow still works without it (the
# agent reads the code from the orchestrator), but replies and real intake need it.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_CREDENTIALS_FILE=./secrets/gmail_oauth.json
GMAIL_TOKEN_FILE=./secrets/gmail_token.json
# Email-firewall behaviour (the watcher vets every email in GMAIL_SOURCE_LABEL):
#   - INBOX (default): vet mail already in the inbox; scams get the Quarantine label, safe mail the
#     Safe label. Set GMAIL_ARCHIVE_SCAMS=1 to also pull scams out of the inbox (archive, not trash).
#   - a holding label (e.g. HoneybankPending) fed by a Gmail filter ("Matches: * -> Skip Inbox,
#     Apply label: HoneybankPending"): true pre-inbox vetting — only cleared mail reaches the inbox.
GMAIL_SOURCE_LABEL=INBOX
GMAIL_QUARANTINE_LABEL=Honeybank/Quarantine
GMAIL_SAFE_LABEL=Honeybank/Safe
GMAIL_ARCHIVE_SCAMS=0
# OTP mail the bank sends to its own persona sub-addresses is sandbox back-channel traffic; the
# watcher files it under GMAIL_INTERNAL_LABEL and archives it out of the inbox. Set to 0 to keep it visible.
GMAIL_HIDE_INTERNAL_MAIL=1
GMAIL_INTERNAL_LABEL=Honeybank/Internal
