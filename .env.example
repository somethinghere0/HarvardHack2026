# Honeybank — single env file for the whole stack. Copy to .env and fill in.
# Leave the FAKE flags at 1 to run everything locally with no real keys (demo-safe, nothing real
# moves). Set a flag to 0 and fill its keys to make that one service live.
#
#   cp .env.example .env
#   python dev.py                 # local, no Docker, all fakes on
#   docker compose up --build     # containers (set NESSIE_FAKE=0 + a real key for live Nessie)

# ─── Capital One Nessie v2 (the bank data layer) ───────────────────────────
# Get a key at https://v2.nessieisreal.com/ (account page). The proxy and orchestrator share it.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
# 1 = use the bundled in-memory fake upstream; 0 = hit the real Nessie API (needs NESSIE_API_KEY).
# (Do not put inline "# comments" after a value — env_file keeps them as part of the value.)
NESSIE_FAKE=1
# Set after registering the webhook (Nessie returns a signing secret once). Optional.
NESSIE_WEBHOOK_SECRET=

# ─── Public URL / Cloudflare tunnel ────────────────────────────────────────
# Nessie webhooks (and the scammer's view of Honeybank) need a public URL back to this machine.
#   quick tunnel (no account):   cloudflared tunnel --url http://localhost:3000
#     -> copy the printed https URL into PUBLIC_URL, leave CLOUDFLARE_TUNNEL_TOKEN blank.
#   named tunnel (stable host):  set a token from the Cloudflare dashboard.
# Blank PUBLIC_URL disables webhook registration; the orchestrator then polls GET /events instead.
PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Proxy <-> orchestrator ────────────────────────────────────────────────
INTERNAL_SECRET=change-me-to-a-long-random-string
# second-factor code on Honeybank login
OTP_REQUIRED=1
# a session can only see its own decoy customer
ENFORCE_CUSTOMER_SCOPE=1
# email = code sent to the persona inbox; direct = agent reads it from the orchestrator (stage fallback)
OTP_MODE=email
OTP_TTL_SECONDS=300

# ─── Gmail (inbound scam mail + OTP/reply delivery) ────────────────────────
# OAuth "Desktop app" client; enable the Gmail API; add your address as a test user. Then run
#   python backend/scripts/gmail_authorize.py   (writes GMAIL_TOKEN_FILE)
GMAIL_FAKE=1
GMAIL_ADDRESS=you@gmail.com
GMAIL_CREDENTIALS_FILE=./secrets/gmail_oauth.json
GMAIL_TOKEN_FILE=./secrets/gmail_token.json

# ─── Daytona (one disposable sandbox per engagement for the decoy agent) ───
# https://www.daytona.io/docs/ — create an API key in the dashboard.
DAYTONA_FAKE=1
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=

# ─── Photon (optional synthetic persona identities; Faker is the fallback) ─
PHOTON_FAKE=1
PHOTON_API_KEY=
PHOTON_API_URL=

# ─── Anthropic (scam classification + decoy replies; heuristics if unset) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
